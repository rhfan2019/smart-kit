{
  "name": "@rhfan2019/smart-kit-core",
  "version": "0.4.0",
  "description": "Metadata model, query generation and data providers for smart-kit (pure TypeScript).",
  "keywords": [
    "odata",
    "odata-v4",
    "csdl",
    "annotations",
    "metadata",
    "typescript"
  ],
  "homepage": "https://github.com/rhfan2019/smart-kit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/rhfan2019/smart-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhfan2019/smart-kit.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "smart-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-imports.mjs ."
  },
  "dependencies": {
    "@sap-ux/edmx-parser": "0.10.0",
    "@sap-ux/annotation-converter": "0.10.23",
    "@sap-ux/vocabularies-types": "0.16.0",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2"
  }
}
