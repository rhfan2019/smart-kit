{
  "name": "@rhfan2019/smart-kit",
  "version": "0.1.0",
  "description": "Metadata-driven, white-box, themeable React building blocks for list and object pages.",
  "keywords": [
    "react",
    "odata",
    "odata-v4",
    "annotations",
    "list-report",
    "object-page",
    "smart-table",
    "mantine",
    "enterprise"
  ],
  "homepage": "https://github.com/rhfan2019/smart-kit/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/rhfan2019/smart-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhfan2019/smart-kit.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "smart-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "smart-kit-source": "./src/entries/context.ts",
      "types": "./dist/entries/context.d.ts",
      "import": "./dist/entries/context.js"
    },
    "./i18n": {
      "smart-kit-source": "./src/entries/i18n.ts",
      "types": "./dist/entries/i18n.d.ts",
      "import": "./dist/entries/i18n.js"
    },
    "./theme": {
      "smart-kit-source": "./src/entries/theme.ts",
      "types": "./dist/entries/theme.d.ts",
      "import": "./dist/entries/theme.js"
    },
    "./util": {
      "smart-kit-source": "./src/entries/util.ts",
      "types": "./dist/entries/util.d.ts",
      "import": "./dist/entries/util.js"
    },
    "./field": {
      "smart-kit-source": "./src/entries/field.ts",
      "types": "./dist/entries/field.d.ts",
      "import": "./dist/entries/field.js"
    },
    "./filter": {
      "smart-kit-source": "./src/entries/filter.ts",
      "types": "./dist/entries/filter.d.ts",
      "import": "./dist/entries/filter.js"
    },
    "./variants": {
      "smart-kit-source": "./src/entries/variants.ts",
      "types": "./dist/entries/variants.d.ts",
      "import": "./dist/entries/variants.js"
    },
    "./table": {
      "smart-kit-source": "./src/entries/table.ts",
      "types": "./dist/entries/table.d.ts",
      "import": "./dist/entries/table.js"
    },
    "./chart": {
      "smart-kit-source": "./src/entries/chart.ts",
      "types": "./dist/entries/chart.d.ts",
      "import": "./dist/entries/chart.js"
    },
    "./object": {
      "smart-kit-source": "./src/entries/object.ts",
      "types": "./dist/entries/object.d.ts",
      "import": "./dist/entries/object.js"
    },
    "./page": {
      "smart-kit-source": "./src/entries/page.ts",
      "types": "./dist/entries/page.d.ts",
      "import": "./dist/entries/page.js"
    },
    "./actions": {
      "smart-kit-source": "./src/entries/actions.ts",
      "types": "./dist/entries/actions.d.ts",
      "import": "./dist/entries/actions.js"
    },
    "./edit": {
      "smart-kit-source": "./src/entries/edit.ts",
      "types": "./dist/entries/edit.d.ts",
      "import": "./dist/entries/edit.js"
    },
    "./messages": {
      "smart-kit-source": "./src/entries/messages.ts",
      "types": "./dist/entries/messages.d.ts",
      "import": "./dist/entries/messages.js"
    },
    "./templates": {
      "smart-kit-source": "./src/entries/templates.ts",
      "types": "./dist/entries/templates.d.ts",
      "import": "./dist/entries/templates.js"
    },
    "./cards": {
      "smart-kit-source": "./src/entries/cards.ts",
      "types": "./dist/entries/cards.d.ts",
      "import": "./dist/entries/cards.js"
    },
    "./styles.css": {
      "smart-kit-source": "./src/theme/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/copy-css.mjs && node ../../scripts/fix-dts-imports.mjs ."
  },
  "dependencies": {
    "@rhfan2019/smart-kit-core": "0.1.0",
    "lucide-react": "1.73.0",
    "write-excel-file": "4.1.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "dayjs": "^1.11.23",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "@tanstack/react-query": "^5.107.1"
  },
  "peerDependenciesMeta": {
    "ag-grid-community": {
      "optional": true
    },
    "ag-grid-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/dates": "9.8.0",
    "dayjs": "1.11.23",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "@tanstack/react-query": "5.107.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "vite-plugin-dts": "5.1.2"
  }
}
