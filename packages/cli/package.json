{
  "name": "@rhfan2019/smart-kit-cli",
  "version": "0.1.0",
  "description": "Development tool for smart-kit: generates CSDL from a PostgreSQL schema and checks hand-written annotation files.",
  "keywords": [
    "odata",
    "csdl",
    "postgresql",
    "codegen",
    "cli"
  ],
  "homepage": "https://github.com/rhfan2019/smart-kit/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/rhfan2019/smart-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhfan2019/smart-kit.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "smart-kit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "smart-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-imports.mjs ."
  },
  "dependencies": {
    "pg": "8.23.1",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2"
  }
}
