{
  "name": "@rhfan2019/smart-kit",
  "version": "0.1.0",
  "description": "Metadata-driven, white-box, themeable React building blocks for list and object pages.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/theme/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/copy-css.mjs"
  },
  "dependencies": {
    "@rhfan2019/smart-kit-core": "0.1.0",
    "lucide-react": "1.73.0",
    "write-excel-file": "4.1.1"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/dates": "9.8.0",
    "dayjs": "1.11.23",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "@tanstack/react-query": "5.107.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/dates": "9.8.0",
    "dayjs": "1.11.23",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "@tanstack/react-query": "5.107.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "vite-plugin-dts": "5.1.2"
  }
}
