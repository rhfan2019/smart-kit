{
  "name": "@rhfan2019/smart-kit-cli",
  "version": "0.1.0",
  "description": "Development tool for smart-kit: generates CSDL from a PostgreSQL schema and checks hand-written annotation files.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": { "node": ">=24" },
  "bin": { "smart-kit": "./dist/bin.js" },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "pg": "8.23.1",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2"
  }
}
