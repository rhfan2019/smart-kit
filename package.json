{
  "name": "smart-kit-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/server",
    "packages/cli",
    "apps/demo",
    "apps/mock",
    "apps/pg-server",
    "apps/storybook"
  ],
  "scripts": {
    "mock": "npm run start -w mock",
    "dev": "npm run dev -w demo",
    "pg:setup": "npm run setup -w pg-server --",
    "pg:generate": "npm run generate -w pg-server --",
    "pg": "npm run start -w pg-server",
    "build": "npm run build -w @rhfan2019/smart-kit-core && npm run build -w @rhfan2019/smart-kit && npm run build -w @rhfan2019/smart-kit-server && npm run build -w @rhfan2019/smart-kit-cli && npm run build -w demo",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/react/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit && tsc -p apps/pg-server/tsconfig.json --noEmit && tsc -p apps/demo/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p apps/storybook/tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-tokens.mjs && node scripts/check-trademark.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:pg": "playwright test -c playwright.pg.config.ts",
    "size": "node scripts/check-size.mjs",
    "trace": "node scripts/trace.mjs",
    "check:trademark": "node scripts/check-trademark.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "samples": "node scripts/export-samples.mjs",
    "storybook": "npm run storybook -w storybook",
    "build-storybook": "npm run build -w storybook",
    "rename-scope": "node scripts/rename-scope.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
