{
  "name": "@rhfan2019/smart-kit-server",
  "version": "0.3.0",
  "description": "A limited OData V4 service on PostgreSQL for smart-kit: URL -> AST -> query plan -> SQL (Node only).",
  "keywords": [
    "odata",
    "odata-v4",
    "postgresql",
    "server",
    "rest",
    "kysely"
  ],
  "homepage": "https://github.com/rhfan2019/smart-kit/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/rhfan2019/smart-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhfan2019/smart-kit.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "smart-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-imports.mjs ."
  },
  "dependencies": {
    "@rhfan2019/smart-kit-core": "0.3.0",
    "chevrotain": "13.2.0",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2"
  }
}
